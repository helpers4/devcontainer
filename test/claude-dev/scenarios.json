{
  "with_cli": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "claude-dev": {
        "installCli": true
      }
    }
  },
  "with_remote_control": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "claude-dev": {
        "remoteControl": true,
        "remoteControlName": "h4 test",
        "remoteControlAutoTrust": true
      }
    }
  }
}
