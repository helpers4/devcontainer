{
  "id": "local-mounts",
  "version": "1.0.6",
  "name": "Local Development Files Mount",
  "description": "Mounts local Git, SSH, GPG, and npm configuration files into the devcontainer with support for custom usernames. Uses a stable SSH socket strategy to avoid dynamic bind-mount failures.",
  "documentationURL": "https://github.com/helpers4/devcontainer/tree/main/features/local-mounts",
  "options": {
    "username": {
      "type": "string",
      "default": "node",
      "description": "Username in the container that should receive synchronized local config files"
    }
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.gitconfig",
      "target": "/tmp/local-mounts/.gitconfig",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.ssh",
      "target": "/tmp/local-mounts/.ssh",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.gnupg",
      "target": "/tmp/local-mounts/.gnupg",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.npmrc",
      "target": "/tmp/local-mounts/.npmrc",
      "type": "bind"
    }
  ],
  "containerEnv": {
    "GPG_TTY": "/dev/pts/0",
    "SSH_AUTH_SOCK": "/tmp/local-mounts/.ssh/agent.sock"
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}