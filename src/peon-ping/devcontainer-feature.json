{
  "id": "peon-ping",
  "version": "2.0.0",
  "name": "Peon Ping — AI Agent Sound Notifications",
  "description": "Plays your host's peon-ping sounds when your AI coding agent finishes or needs permission — Claude Code, Cursor and Codex hooks, plus the Peon Pet VS Code extension. Nothing to configure: the sound and pack come from your host. Also self-heals your devcontainer setup.",
  "documentationURL": "https://github.com/helpers4/devcontainer/tree/main/src/peon-ping",
  "licenseURL": "https://github.com/helpers4/devcontainer/blob/main/LICENSE",
  "keywords": ["helpers4", "peon", "audio", "notifications", "ai"],
  "customizations": {
    "vscode": {
      "extensions": [
        "smcqueen.vscode-peon-pet"
      ],
      "settings": {
        "peon-pet.size": "medium"
      }
    }
  },
  "postCreateCommand": "/usr/local/bin/peon-ping register",
  "postStartCommand": "/usr/local/bin/peon-ping check",
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/helpers4/devcontainer/claude-dev"
  ],
  "dependsOn": {
    "ghcr.io/helpers4/devcontainer/helpers4-common:1": {}
  }
}
