{
  "id": "claude-dev",
  "version": "1.1.0",
  "name": "Claude Code Development Environment",
  "description": "Installs the Claude Code IDE extension (anthropic.claude-code) for VS Code and Cursor. Shares host OAuth credentials via a live symlink — no re-authentication needed after container rebuilds.",
  "documentationURL": "https://github.com/helpers4/devcontainer/tree/main/src/claude-dev",
  "licenseURL": "https://github.com/helpers4/devcontainer/blob/main/LICENSE",
  "keywords": ["helpers4", "claude", "anthropic", "ai", "vscode"],
  "options": {
    "username": {
      "type": "string",
      "default": "node",
      "description": "Username in the container that should receive the Claude credentials symlink."
    }
  },
  "mounts": [
    {
      // Staging path — avoids mounting directly to ~/.claude/.credentials.json which
      // would create a host directory if the source file doesn't exist yet.
      "source": "${localEnv:HOME}/.claude/.credentials.json",
      "target": "/mnt/h4claude/.credentials.json",
      "type": "bind"
    }
  ],
  "postStartCommand": "/usr/local/share/claude-dev/setup-credentials.sh",
  "customizations": {
    "vscode": {
      // Works for both VS Code and Cursor (same extension registry).
      "extensions": [
        "anthropic.claude-code"
      ]
    }
    // JetBrains (IntelliJ, WebStorm, …): add once the plugin xmlId is confirmed.
    // The marketplace page is https://plugins.jetbrains.com/plugin/27310 (vendor: anthropic).
    // "jetbrains": {
    //   "plugins": ["<xmlId-to-be-confirmed>"]
    // }
    //
    // Zed: no standard devcontainer customization format yet.
    // Extensions are managed through Zed's own extension registry and ~/.config/zed/settings.json.
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
